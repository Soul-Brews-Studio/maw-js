# docker/review-plane.compose.yml env — copy to docker/.env (gitignored) and fill in.
# NEVER commit real secrets.

# Desk secret — Bearer credential for GET /api/review/pending + /stream.
# Generate: openssl rand -base64 32   (MUST match the desk side's value)
MAW_REVIEW_DESK_SECRET=

# Base URL of the desk UI; the review `url` is built as <this>/r/:token.
MAW_REVIEW_DESK_URL=http://localhost:5173

# Host loopback port that maps to the container's 3456 (local e2e only).
REVIEW_PLANE_HOST_PORT=18080
